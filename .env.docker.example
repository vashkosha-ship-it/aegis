# Настройки контейнеров для локальной разработки.
# Скопировать в .env рядом с docker-compose.yml и заполнить.
#
# Файл .env в репозиторий не коммитится. Этот пример — коммитится, но паролей
# в нём быть не должно: смысл в том, чтобы у каждого разработчика они были
# свои, а не одни и те же на всех, как раньше.

# --- PostgreSQL ---
POSTGRES_USER=neon
POSTGRES_DB=neon_stack
# Задайте свой. Сгенерировать:  python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=

# --- MinIO ---
# Версия образа. Узнать, что скачано сейчас:
#   docker image inspect minio/minio --format '{{index .RepoTags 0}}'
# Формат тега: RELEASE.ГГГГ-ММ-ДДTЧЧ-ММ-ССZ
MINIO_TAG=
MINIO_ROOT_USER=
# Минимум 8 символов — иначе MinIO не запустится
MINIO_ROOT_PASSWORD=

# После заполнения строка подключения для backend/.env:
#   DATABASE_URL=postgresql+asyncpg://neon:ПАРОЛЬ@localhost:5432/neon_stack
#   DATABASE_URL_SYNC=postgresql+psycopg2://neon:ПАРОЛЬ@localhost:5432/neon_stack
#   REDIS_URL=redis://localhost:6379/0
