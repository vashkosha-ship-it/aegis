[Unit]
Description=Aegis daily PostgreSQL and storage backup
After=postgresql.service
Requires=postgresql.service

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/aegis/backend
EnvironmentFile=/opt/aegis/backend/.env
Environment="AEGIS_BACKUP_DIR=/var/backups/aegis"
Environment="AEGIS_BACKUP_KEEP_DAYS=14"
ExecStart=/bin/bash /opt/aegis/backend/deploy/backup.sh

UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/backups/aegis
